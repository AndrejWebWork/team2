# Копирајте во `.env` и внесете вистински вредности.

# PostgreSQL конекција (на Acton виртуелната машина во продукција)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ekoskopje

# Порта на API-то
PORT=4000

# Каде се снимаат прикачените слики (патеките се чуваат во базата)
UPLOAD_DIR=./uploads

# Јавна база-адреса за прикажување на сликите (без / на крајот)
PUBLIC_BASE_URL=http://localhost:4000

# Макс. големина по слика во бајти (~3 MB)
MAX_UPLOAD_BYTES=3145728

# Дозволен origin за CORS (веб клиентот)
CORS_ORIGIN=http://localhost:5173

# Таен токен за админ операции (менување статус на пријава).
# Ако е празно, заштитата е ИСКЛУЧЕНА (само за локален развој).
# Во продукција постави силна случајна вредност и внеси ја истата во
# frontend-от како VITE_ADMIN_TOKEN.
ADMIN_TOKEN=

# Лозинка за админ сметката (се хешира со bcrypt преку `npm run admin:password`).
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@ekoskopje.mk

# Push нотификации (FCM HTTP v1). Ако е празно, push е ИСКЛУЧЕН (работат само
# локалните нотификации на телефон). Постави го или како целиот JSON од сервисниот
# клуч, или како патека до .json фајлот. Го добиваш од:
#   Firebase Console → Project settings → Service accounts → Generate new private key
# Пример (патека):  FCM_SERVICE_ACCOUNT=./secrets/firebase-service-account.json
# Пример (inline):  FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
FCM_SERVICE_ACCOUNT=

# Brevo (Sendinblue) — forgot password emails. Бесплатен tier (~300 emails/ден).
# 1. Регистрирај се на https://www.brevo.com (free plan, без картичка)
# 2. SMTP & API → API keys → Create API key
# 3. Senders → Add sender → верификувај email (пр. noreply@ekoskopje.mk)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EkoSkopje

# Јавна адреса на frontend-от (за reset линк во email). Во prod:
# APP_PUBLIC_URL=https://team2-zeta.vercel.app
APP_PUBLIC_URL=http://localhost:5173
