# Копирајте го овој фајл во `.env` и внесете ги вистинските вредности.
# Сите променливи мора да почнуваат со VITE_ за да бидат достапни во клиентот.

# WAQI / aqicn.org токен за реално-временски податоци за квалитет на воздух.
# Побарајте свој токен на https://aqicn.org/data-platform/token/
VITE_WAQI_TOKEN=your_waqi_token_here

# Адреса на EkoSkopje backend API-то (за пријави, слики, јазик на корисник).
#
# ВЕБ (dev на истиот компјутер): http://localhost:4000
# МОБИЛЕН уред (Capacitor Android/iOS): localhost покажува кон САМИОТ телефон,
#   па мора да ја внесеш LAN IP-адресата на компјутерот што го држи backend-от,
#   пр. http://192.168.1.209:4000  (најди ја со `ipconfig` / `ifconfig`).
# ПРОДУКЦИЈА: https://api.твој-домен (HTTPS).
VITE_API_URL=http://localhost:4000

# Админ токен за заштитените операции (менување статус на пријава).
# Мора да се совпаѓа со ADMIN_TOKEN во backend-от. Ако е празно, не се праќа
# (backend-от тогаш дозволува без токен — само за локален развој).
# ЗАБЕЛЕШКА: ова е вградено во клиентот, па во продукција вистинската заштита
# треба да е преку најавен админ (сесија/JWT), не само токен.
VITE_ADMIN_TOKEN=
